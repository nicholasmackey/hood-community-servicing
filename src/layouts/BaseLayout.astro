---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  /** Override the shared social card. Resolved against `site` in astro.config.mjs. */
  image?: string;
}

const { title, description, image = '/og-image.png' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase(image), Astro.site);
const faviconIco = withBase('/favicon.ico');
const faviconSvg = withBase('/apple-touch-icon.svg');
const faviconPng = withBase('/favicon.png');
const appleTouchIcon = withBase('/apple-touch-icon.png');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph: Facebook, LinkedIn, iMessage, Slack -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="HOOD Community Servicing" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1050" />
    <meta property="og:image:height" content="600" />
    <meta
      property="og:image:alt"
      content="HOOD Community Servicing. Staffing, pool management, and everyday community services in DFW."
    />

    <!-- Twitter/X renders the same asset as a large summary card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {/*
      The .ico is declared rather than left to sit in public/ unnamed. A
      browser with no icon it can use falls back to a hardwired request for
      /favicon.ico at the origin root, and this site is served from a
      subdirectory, so that request lands above the base and 404s — which is
      the "Request URLs for public/ assets must also include your base" the
      dev server reports. Naming the file here is what keeps the request
      inside the base.

      Every href below is built by withBase off import.meta.env.BASE_URL, so
      dropping `base` from astro.config for a root domain resolves these to
      /favicon.ico and friends with nothing to change here.

      No `type` on this one: the file is a 32px PNG carrying an .ico
      extension, so let the browser sniff it rather than claim image/x-icon.
    */}
    <link rel="icon" sizes="32x32" href={faviconIco} />
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/png" sizes="32x32" href={faviconPng} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon} />

    <Font cssVariable="--font-inter" preload />

    {/*
      Scroll reveal, page-wide. Paired with the [data-reveal] rules in
      global.css, which do nothing until this script sets the flag below.

      The flag is set here, in <head>, rather than after the DOM is ready: the
      rules hide their elements, and setting the flag any later means the first
      screen paints visible and then blinks out. Everything that needs the DOM
      waits for it separately.

      Not setting the flag is the failure mode, and it is a safe one — no JS,
      no IntersectionObserver, or reduced motion all leave every [data-reveal]
      element as ordinary visible content.
    */}
    <script is:inline>
      (() => {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        document.documentElement.dataset.revealReady = '';

        const start = () => {
          const targets = document.querySelectorAll('[data-reveal]');
          if (!targets.length) return;

          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-revealed');
                // Once only. These are entrances, not scroll-linked state.
                observer.unobserve(entry.target);
              }
            },
            /* Fire a little before the block reaches the bottom edge, so it is
               finishing as it arrives rather than starting once it is already
               being read. */
            { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
          );

          targets.forEach((target) => observer.observe(target));
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', start, { once: true });
        } else {
          start();
        }
      })();
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-3 focus:text-[15px] focus:font-semibold focus:text-white"
    >
      Skip to content
    </a>

    <slot />
  </body>
</html>
