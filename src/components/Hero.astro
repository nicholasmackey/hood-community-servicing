---
/*
 * Full-screen video hero. The video is decorative background only: no
 * controls, no audio, aria-hidden, and never focusable. All hero content sits
 * above a dark scrim so the white copy stays readable over any frame.
 */
const VIDEO_SRC = 'https://assets.wellworncreative.com/hood-hero-movie.mov';
---

<section
  class="hero relative isolate flex w-full items-center justify-center overflow-hidden bg-ink text-white"
>
  <video
    class="absolute inset-0 h-full w-full object-cover"
    src={VIDEO_SRC}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    tabindex="-1"
    aria-hidden="true"
    data-hero-video
  >
  </video>

  {/*
    Two layers rather than one flat wash. The gradient weights the top and
    bottom edges, where the copy is not, so the middle of the frame — the part
    of the footage worth seeing — stays the lightest part of the shot; the flat
    scrim underneath it is what guarantees a readable floor on a frame that
    happens to be bright everywhere.
  */}
  <div class="absolute inset-0 bg-black/[0.32]" aria-hidden="true"></div>
  <div
    class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,0.42)_0%,rgba(0,0,0,0.08)_42%,rgba(0,0,0,0.52)_100%)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative flex flex-col items-center py-8 text-center md:py-10">
    <h1
      class="max-w-[17ch] text-balance text-[clamp(2rem,1.15rem+4.2vw,4.75rem)] font-extrabold uppercase leading-[0.96] tracking-[-0.02em]"
    >
      The team that keeps your community moving.
    </h1>

    <p
      class="mt-4 max-w-[62ch] text-pretty text-[15px] font-medium leading-[1.5] text-white/90 sm:text-[16px] md:mt-5 md:text-[18px]"
    >
      Lifeguard staffing, pool management, maintenance, cleanup, hauling, and
      everyday community services for HOAs, neighborhoods, and residential
      communities.
    </p>

    <a href="#contact" class="btn btn-primary mt-6 md:mt-7">Talk to HOOD</a>
  </div>

  {/*
    A full-screen hero ends exactly at the fold, so nothing about it says there
    is a page underneath. This is that signal and nothing else: one hairline
    with a red segment running down it, at the foot of the frame, from tablet
    up where there is room for it under the button.
  */}
  <span class="hero__scroll" aria-hidden="true"></span>
</section>

<style>
  /* Intentionally shorter than the viewport so the next section is always
     discoverable. */
  .hero {
    height: 60vh;
    height: 60svh;
  }

  .hero__scroll {
    display: none;
  }

  @media (max-width: 480px) {
    .hero h1 {
      max-width: 100%;
      font-size: 1.8125rem;
    }
  }

  @media (min-width: 768px) {
    .hero__scroll {
      display: block;
      position: absolute;
      bottom: 1.25rem;
      left: 50%;
      width: 1px;
      height: 34px;
      transform: translateX(-50%);
      background-color: color-mix(in srgb, #ffffff 26%, transparent);
      overflow: hidden;
    }

    /* The red segment. Travels the length of the rule and starts over, which
       is the one piece of motion the hero has after the video itself. */
    .hero__scroll::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      top: 0;
      height: 12px;
      background-color: var(--color-brand-red);
      animation: hero-scroll 2200ms cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }
  }

  @keyframes hero-scroll {
    0% {
      transform: translateY(-100%);
    }
    55%,
    100% {
      transform: translateY(34px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll {
      display: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const video = document.querySelector('[data-hero-video]');
    if (!video) return;

    /* Reduced motion: never autoplay. The element stays in place, so the
       browser paints its first frame as a still once metadata loads, and the
       dark hero background stands in until then. Runs inline, right after the
       element parses, so `autoplay` is dropped before playback can start. */
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    const apply = () => {
      if (reduced.matches) {
        video.removeAttribute('autoplay');
        video.pause();
      } else {
        video.play().catch(() => {});
      }
    };

    apply();
    reduced.addEventListener('change', apply);
  })();
</script>
