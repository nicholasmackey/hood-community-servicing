---
import Logo from './Logo.astro';

/*
 * No direct contact column. Hood are standing up a business line and have no
 * published address to give out in the meantime, and a footer is the wrong
 * place to guess: the form is the way in, and Contact is a row in the index
 * below like every other section. Restore a column here when the number is
 * live.
 */
const nav = [
  { label: 'Why HOOD', href: '#why-hood' },
  { label: 'Services', href: '#services' },
  { label: 'Team', href: '#team' },
  { label: 'Contact', href: '#contact' },
];

const year = new Date().getFullYear();

/* Brand red, closing the page against the white form above. */
---

<footer class="footer text-white">
  <Logo variant="mark" alt="" class="footer__watermark" />

  <div class="container-page relative z-[1] py-12 lg:py-14">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <Logo variant="reverse" class="h-9 w-auto" alt="HOOD Community Servicing" />
        <p class="mt-5 max-w-[34ch] text-[16px] font-medium">
          Staffing, pool management, and everyday community services
        </p>
        <p class="mt-1 text-[16px] text-white">Serving DFW</p>
      </div>

      {/* One column left, so it lies down into two ranks of links on a phone
          rather than running the height of the panel on its own. */}
      <nav aria-label="Footer">
        <h2 class="text-[13px] font-semibold uppercase tracking-[0.1em] text-white">
          Site
        </h2>
        <ul
          class="mt-4 grid grid-cols-2 gap-x-10 gap-y-2 text-[16px] sm:grid-cols-1 sm:gap-y-2"
        >
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {/* No privacy link: there is no policy page to point it at, and a footer
        link to a 404 is worse than no link. Add both together. */}
    <div class="mt-10 border-t border-white/25 pt-6 text-[14px] text-white">
      <p>&copy; {year} HOOD Community Servicing, LLC. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  /* No hairline: the footer meets the white form above, so the colour change
     is the edge. */
  .footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--color-brand-red);
  }

  .footer :global(.footer__watermark) {
    position: absolute;
    right: clamp(-18rem, -12vw, -8rem);
    top: 58%;
    z-index: 0;
    width: clamp(46rem, 78vw, 72rem);
    height: auto;
    max-width: none;
    transform: translateY(-50%);
    opacity: 0.18;
    pointer-events: none;
    user-select: none;
  }

  @media (max-width: 639px) {
    .footer :global(.footer__watermark) {
      right: -22rem;
      top: 62%;
      width: 50rem;
    }
  }
</style>
