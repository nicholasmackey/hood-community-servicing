---
import Logo from './Logo.astro';
import { withBase } from '../utils/paths';

// TODO: replace every value below with real HOOD contact details.
const contact = {
  phone: '(000) 000-0000',
  phoneHref: 'tel:+10000000000',
  email: 'email@placeholder.com',
  website: 'hoodcommunityservicing.com',
  websiteHref: withBase('/'),
};

const privacyHref = withBase('/privacy');

const nav = [
  { label: 'Why HOOD', href: '#why-hood' },
  { label: 'Services', href: '#services' },
  { label: 'Team', href: '#team' },
  { label: 'Contact', href: '#contact' },
];

const year = new Date().getFullYear();

/* A clear charcoal step away from the near-black form above. */
---

<footer class="footer text-white">
  <Logo variant="mark" alt="" class="footer__watermark" />

  <div class="container-page relative z-[1] py-12 lg:py-14">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <Logo variant="reverse" class="h-9 w-auto" alt="HOOD Community Servicing" />
        <p class="mt-5 max-w-[34ch] text-[16px] font-medium">
          Staffing, pool management, and everyday community services
        </p>
        <p class="mt-1 text-[16px] text-white/70">Serving DFW</p>
      </div>

      <div class="flex flex-col gap-10 sm:flex-row sm:gap-16">
        <div>
          <h2 class="text-[13px] font-semibold uppercase tracking-[0.1em] text-white/70">
            Contact
          </h2>
          <ul class="mt-4 space-y-2 text-[16px]">
            <li>
              <a href={contact.phoneHref} class="transition-colors hover:text-brand-red-soft">
                {contact.phone}
              </a>
            </li>
            <li>
              <a href={`mailto:${contact.email}`} class="transition-colors hover:text-brand-red-soft">
                {contact.email}
              </a>
            </li>
            <li>
              <a href={contact.websiteHref} class="transition-colors hover:text-brand-red-soft">
                {contact.website}
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h2 class="text-[13px] font-semibold uppercase tracking-[0.1em] text-white/70">
            Site
          </h2>
          <ul class="mt-4 space-y-2 text-[16px]">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} class="transition-colors hover:text-brand-red-soft">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-white/15 pt-6 text-[14px] text-white/70 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} HOOD Community Servicing, LLC. All rights reserved.</p>
      <!-- TODO: point at the real privacy policy once it exists. -->
      <a href={privacyHref} class="transition-colors hover:text-brand-red-soft">Privacy</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: #474440;
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  .footer :global(.footer__watermark) {
    position: absolute;
    right: clamp(-18rem, -12vw, -8rem);
    top: 58%;
    z-index: 0;
    width: clamp(46rem, 78vw, 72rem);
    height: auto;
    max-width: none;
    transform: translateY(-50%);
    opacity: 0.18;
    pointer-events: none;
    user-select: none;
  }

  @media (max-width: 639px) {
    .footer :global(.footer__watermark) {
      right: -22rem;
      top: 62%;
      width: 50rem;
    }
  }
</style>
