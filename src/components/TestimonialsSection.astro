---
interface Testimonial {
  quote: string;
  name: string;
  role: string;
  community: string;
  location: string;
}

const testimonials: Testimonial[] = [
  {
    quote:
      'Managing the pool had become incredibly stressful. We were dealing with break-ins, trash, and constant issues that kept piling up. Tim and Tamika came in and turned things around within a week. They keep me informed on the things I actually need to know, while handling the smaller issues themselves. I’d tell any HOA not to hesitate to hire them.',
    name: 'Nicholas Mackey',
    role: 'HOA President',
    community: 'Falcon Heights HOA',
    location: 'Forney, Texas',
  },
  /* UNAPPROVED. The wording below was drafted for Ashley rather than quoted
     from her, and it is attributed to a named person at a named company. Get
     it approved or replace it with her own words before this goes public. The
     Falcon Heights quote above is real. */
  {
    quote:
      'Hood has been a great partner to work with. Tim and Tamika are responsive, dependable, and proactive about handling issues before they become bigger problems. They communicate well, take ownership of the day-to-day details, and make things easier for both management and the communities we serve.',
    name: 'Ashley Vandiver',
    role: 'HOA Manager',
    community: 'Legacy Southwest Property Management',
    location: 'Plano, Texas · DFW',
  },
];

---

<section
  id="testimonials"
  class="section border-b border-white/15 bg-night text-white"
>
  <div class="container-page">
    <div class="max-w-[60rem]">
      <div>
        <span class="eyebrow eyebrow-on-dark" data-reveal>
          Community confidence
        </span>
        <h2 class="h-section mt-2.5 max-w-[24ch]" data-reveal>
          Don’t take our word for it.
        </h2>
      </div>

      <p
        class="mt-4 max-w-[58ch] text-[18px] font-medium leading-[1.4] text-white/70 sm:text-[20px] lg:text-[22px]"
        data-reveal
        style="--reveal-i:1"
      >
        See what property managers and communities have said about working with us.
      </p>
    </div>

    {
      testimonials.length > 0 ? (
        <div class="mt-8 grid gap-5 lg:mt-10 lg:grid-cols-2 lg:gap-6">
          {testimonials.map((testimonial, index) => (
            <figure
              class="group relative isolate flex h-full flex-col overflow-hidden border border-white/20 bg-white/[0.05] p-6 transition-[transform,border-color,background-color] duration-300 ease-out hover:-translate-y-1 hover:border-white/30 hover:bg-white/[0.07] motion-reduce:transform-none motion-reduce:transition-none sm:p-7"
              data-reveal
              style={`--reveal-i:${index}`}
            >
              <span
                class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 bg-brand-red transition-transform duration-300 ease-out group-hover:scale-x-100 motion-reduce:transition-none"
                aria-hidden="true"></span>

              <div class="relative z-[1]">
                <p class="text-[10px] font-bold uppercase tracking-[0.12em] text-brand-red-soft">
                  Customer story
                </p>

                <div class="mt-4">
                  <p class="text-[20px] font-bold leading-tight tracking-[-0.025em] sm:text-[22px]">
                    {testimonial.community}
                  </p>
                  <p class="mt-1.5 text-[11px] font-medium uppercase tracking-[0.08em] text-white/55">
                    {testimonial.location}
                  </p>
                </div>
              </div>

              <blockquote class="relative z-[1] mt-7 mb-5 text-[16px] font-medium leading-[1.55] tracking-[-0.015em] text-white sm:text-[17px] lg:text-[17px]">
                {testimonial.quote}
              </blockquote>

              <figcaption class="relative z-[1] mt-8 border-t border-white/20 pt-5 pr-20 lg:mt-auto">
                <strong class="block text-[15px] font-bold leading-tight">
                  {testimonial.name}
                </strong>
                <span class="mt-1 block text-[13px] leading-snug text-white/60">
                  {testimonial.role}
                </span>
              </figcaption>

              <span
                class="pointer-events-none absolute -bottom-24 right-3 z-0 select-none text-[9rem] font-extrabold leading-none text-brand-red-soft opacity-[0.14] sm:-bottom-28 sm:text-[10rem]"
                aria-hidden="true">”</span>
            </figure>
          ))}
        </div>
      ) : null
    }
  </div>
</section>
