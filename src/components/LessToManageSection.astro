---
import HoodMark3D from './HoodMark3D.astro';
---

<section id="less-to-manage" class="less bg-surface">
  <div class="container-page less__grid">
    <div class="less__copy">
      <h2 class="h-section max-w-[22ch]" data-reveal>
        One call. Fewer things to chase down.
      </h2>

      <p
        class="intro-copy mt-4 text-ink/80"
        data-reveal
        style="--reveal-i:1"
      >
        Managing a community often means coordinating people, vendors, schedules,
        and small problems that cannot wait. HOOD gives you one place to start
        when something needs attention.
      </p>

      <a href="#contact" class="less__link" data-reveal style="--reveal-i:2">
        Start with HOOD
        <span aria-hidden="true">&#8599;</span>
      </a>
    </div>

    <div class="less__visual" data-reveal style="--reveal-i:1">
      <HoodMark3D />
    </div>
  </div>
</section>

<style>
  .less {
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .less__grid {
    display: grid;
    align-items: center;
    gap: 1.75rem;
    padding-block: var(--section-space);
  }

  .less__copy {
    position: relative;
    z-index: 1;
  }

  .less__visual {
    width: 100%;
  }

  .less__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--color-ink);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    transition: gap 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .less__link:hover {
    gap: 0.8rem;
    border-color: var(--color-brand-red);
    color: var(--color-brand-red);
  }

  @media (min-width: 768px) {
    .less__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
      gap: clamp(2rem, 4vw, 4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .less__link {
      transition: none;
    }
  }
</style>
