---
import HoodMark3D from './HoodMark3D.astro';
import { withBase } from '../utils/paths';

const hoodWordmark = withBase('/hood-wordmark.svg');
---

<section id="less-to-manage" class="less bg-surface">
  <div class="container-page less__grid">
    <div class="less__copy">
      <h2 class="h-section max-w-[22ch]" data-reveal>
        <span class="block">Fewer things</span>
        <span class="block">to chase down.</span>
      </h2>

      <p
        class="intro-copy mt-4 text-ink/80"
        data-reveal
        style="--reveal-i:1"
      >
        Managing a community often means coordinating people, vendors, schedules,
        and small problems that cannot wait. HOOD gives you one place to start
        when something needs attention.
      </p>

      <a href="#contact" class="less__link" data-reveal style="--reveal-i:2">
        Let us know how we can help.
        <span aria-hidden="true">&phone;</span>
      </a>
    </div>

    <div class="less__visual" data-reveal style="--reveal-i:1">
      <img
        class="less__word"
        src={hoodWordmark}
        width="507"
        height="92"
        alt=""
        aria-hidden="true"
        style="opacity: 0.03"
      />
      <div class="less__mark">
        <HoodMark3D />
      </div>
    </div>
  </div>
</section>

<style>
  .less {
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .less__grid {
    display: grid;
    align-items: center;
    gap: 1.75rem;
    padding-block: var(--section-space);
  }

  .less__copy {
    position: relative;
    z-index: 1;
  }

  .less__visual {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-width: 0;
    width: 100%;
  }

  .less__word {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: calc(var(--gutter) * -1);
    width: clamp(22rem, 118vw, 32rem);
    max-width: none;
    height: auto;
    pointer-events: none;
    user-select: none;
    transform: translateY(-50%);
  }

  .less__mark {
    position: relative;
    z-index: 1;
    isolation: isolate;
    width: 100%;
  }

  .less__mark::before {
    content: '';
    position: absolute;
    z-index: -1;
    bottom: 16%;
    left: 50%;
    width: 36%;
    height: 3.5%;
    background: rgb(43 33 29 / 0.1);
    filter: blur(12px);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .less__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--color-ink);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    transition: gap 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .less__link:hover {
    gap: 0.8rem;
    border-color: var(--color-brand-red);
    color: var(--color-brand-red);
  }

  @media (min-width: 768px) {
    .less__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
      gap: clamp(2rem, 4vw, 4rem);
    }

    .less__word {
      right: calc(
        (100vw - min(100vw, var(--container-max))) / -2 - var(--gutter)
      );
      width: clamp(30rem, 48vw, 58rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .less__link {
      transition: none;
    }
  }
</style>
