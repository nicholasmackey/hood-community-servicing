---
interface Service {
  title: string;
  body: string;
  image: string;
}

const services: Service[] = [
  {
    title: 'Lifeguard staffing + pool monitoring',
    body: 'Staffing and on-site monitoring for community pools.',
    image: '/images/services/pool-staffing.jpg',
  },
  {
    title: 'Pool management',
    body: 'Day-to-day support for the work that keeps community pools ready for residents.',
    image: '/images/services/pool-management.jpg',
  },
  {
    title: 'Pet waste removal + haul',
    body: 'Routine removal and hauling to help keep shared outdoor areas cleaner.',
    image: '/images/services/pet-waste.jpg',
  },
  {
    title: 'Small hauls',
    body: 'Help moving away unwanted items, debris, and other small loads from community spaces.',
    image: '/images/services/small-hauls.jpg',
  },
  {
    title: 'Common area cleanups',
    body: 'Cleanup support for shared spaces that need regular or one-time attention.',
    image: '/images/services/common-area-cleanup.jpg',
  },
  {
    title: 'Power washing',
    body: 'Cleaning for walkways, pool decks, common areas, and other shared surfaces.',
    image: '/images/services/power-washing.jpg',
  },
  {
    title: 'Community support',
    body: 'Practical help for the other day-to-day needs that come up around an HOA community.',
    image: '/images/services/community-support.jpg',
  },
];
---

<section id="services" class="services bg-night text-white" data-service-gallery>
  <div class="container-page section">
    <div class="services__intro max-w-[60rem]" data-reveal>
      <h2 class="h-section">What we handle.</h2>

      <p class="intro-copy mt-4 text-white/80">
        Dependable support for the work that keeps shared spaces staffed,
        maintained, and ready for the people who use them.
      </p>
    </div>

    <div class="services__body mt-8 lg:mt-10" data-service-body>
      <ul class="services__list">
        {
          services.map((service, index) => (
            <li
              class="service"
              data-service={index}
              data-reveal
              style={`--reveal-i:${index % 2}`}
            >
              <span class="service__line" aria-hidden="true" />
              <div class="service__content">
                <h3 class="service__title">{service.title}</h3>
                <p class="service__copy">{service.body}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="services__preview" aria-hidden="true">
        {
          services.map((service, index) => (
            <img
              class="services__preview-image"
              data-service-image={index}
              data-active={index === 0 ? 'true' : undefined}
              src={service.image}
              alt=""
              width="1000"
              height="1200"
              loading="lazy"
              decoding="async"
            />
          ))
        }
        <span class="services__preview-wash" />
      </div>
    </div>

    <div class="services__callout" data-reveal>
      <div>
        <p class="text-[20px] font-bold tracking-[-0.025em] md:text-[23px]">
          Need something else taken care of?
        </p>
        <p class="mt-2 max-w-[52ch] text-[16px] leading-[1.55] text-white/70">
          HOOD is continuing to add services based on what communities need.
        </p>
      </div>

      <a href="#contact" class="btn btn-primary shrink-0">Talk to HOOD</a>
    </div>
  </div>
</section>

<style>
  .services__intro {
    display: block;
  }

  .services__list {
    display: grid;
  }

  .service {
    position: relative;
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }

  .service:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
  }

  .service__line {
    position: absolute;
    inset: -1px 0 auto;
    width: 100%;
    height: 2px;
    background: var(--color-brand-red);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service__content {
    padding-block: 1.35rem;
  }

  .service__title {
    max-width: 26ch;
    font-size: clamp(1.2rem, 0.95rem + 0.8vw, 1.65rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .service__copy {
    margin-top: 0.55rem;
    max-width: 42ch;
    color: rgb(255 255 255 / 0.66);
    font-size: 16px;
    line-height: 1.5;
  }

  .services__callout {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    margin-top: 2rem;
    padding: 1.5rem;
    border-left: 3px solid var(--color-brand-red);
    background: rgb(255 255 255 / 0.055);
  }

  .services__preview {
    display: none;
  }

  @media (min-width: 768px) {
    .services__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .service:nth-child(even) {
      border-left: 1px solid rgb(255 255 255 / 0.18);
      padding-left: clamp(1.5rem, 3vw, 3rem);
    }

    .service:nth-child(odd) {
      padding-right: clamp(1.5rem, 3vw, 3rem);
    }

    .service:nth-last-child(2) {
      border-bottom: 1px solid rgb(255 255 255 / 0.18);
    }

    .service__content {
      min-height: 9rem;
      padding-block: 1.55rem;
    }

    .services__callout {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
      padding: 1.75rem 2rem;
    }
  }

  @media (hover: hover) {
    .service:hover .service__line,
    .service[data-active] .service__line {
      transform: scaleX(1);
    }

    .service__content {
      transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .service:hover .service__content {
      transform: translateX(0.3rem);
    }
  }

  @media (min-width: 1024px) and (hover: hover) {
    .services__body {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(17rem, 0.85fr);
      align-items: stretch;
      gap: clamp(2rem, 4vw, 3.5rem);
    }

    .services__preview {
      position: relative;
      display: block;
      min-height: 36rem;
      overflow: hidden;
      border: 1px solid rgb(255 255 255 / 0.18);
      background: rgb(255 255 255 / 0.04);
    }

    .services__preview-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transform: scale(1.018);
      filter: saturate(0.82) contrast(1.04);
      transition:
        opacity 260ms ease,
        transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .services__preview-image[data-active] {
      opacity: 1;
      transform: scale(1);
    }

    .services__preview-wash {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgb(43 33 29 / 0.02), rgb(43 33 29 / 0.2));
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service__line,
    .service__content,
    .services__preview-image {
      transition: none;
    }
  }
</style>

<script>
  const galleries = document.querySelectorAll<HTMLElement>('[data-service-gallery]');

  galleries.forEach((gallery) => {
    const serviceBody = gallery.querySelector<HTMLElement>('[data-service-body]');
    const services = Array.from(gallery.querySelectorAll<HTMLElement>('[data-service]'));
    const images = Array.from(gallery.querySelectorAll<HTMLElement>('[data-service-image]'));

    const setActiveService = (activeIndex: number | null) => {
      services.forEach((service, index) => {
        service.toggleAttribute('data-active', index === activeIndex);
      });

      const activeImageIndex = activeIndex ?? 0;
      images.forEach((image, index) => {
        image.toggleAttribute('data-active', index === activeImageIndex);
      });
    };

    services.forEach((service, index) => {
      service.addEventListener('pointerenter', () => setActiveService(index));
    });

    serviceBody?.addEventListener('pointerleave', () => setActiveService(null));
  });
</script>
