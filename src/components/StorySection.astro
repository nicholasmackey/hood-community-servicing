---
import { withBase } from '../utils/paths';

/*
 * Hood's own photography, from their own sites. Phone frames rather than a
 * shoot, and the strip is built to keep them that way: documentary pictures at
 * one size carrying the same light desaturation the services previews do, so
 * the page reads as one grade.
 *
 * The files are pre-derived WebP at three widths — see
 * scripts/optimize-team-photos.mjs — rather than <Image /> from astro:assets,
 * because Astro's image service needs sharp installed at the project root and
 * this build deliberately has no native dependency in it. Same output, same
 * srcset, nothing for the deploy to resolve.
 *
 * Two layouts off one list. On a phone the frames run as a marquee that never
 * stops, which is why the set is rendered twice: the second pass is a
 * decorative copy so the track can translate by exactly half its width and
 * land the first clone where its original was. From 640px up the copies are
 * dropped and the frames resolve into the grid, staggered at 900px.
 */
const WIDTHS = [400, 640, 1000];

const photo = (name: string, alt: string) => ({
  alt,
  src: withBase(`/images/team/${name}-640.webp`),
  srcset: WIDTHS.map((w) => `${withBase(`/images/team/${name}-${w}.webp`)} ${w}w`).join(', '),
});

const gallery = [
  photo(
    'team-guard-crew',
    'Four guards standing together under the shade structure at a community pool.'
  ),
  photo(
    'team-sign-in-log',
    'A staff member in a HOOD Community Servicing shirt at the pool sign-in and incident log.'
  ),
  photo(
    'team-lifeguard-stand',
    'A lifeguard on the stand beside a community pool and splash pad.'
  ),
  photo('team-pool-monitor', 'A pool monitor on duty at the edge of a community pool.'),
];

/* The marquee needs the run twice over. The clones are hidden from assistive
   tech and carry no reveal, so the list is still four pictures long to a
   screen reader and nothing off-screen is waiting on an observer. */
const strip = [
  ...gallery.map((item) => ({ ...item, clone: false })),
  ...gallery.map((item) => ({ ...item, clone: true })),
];

/* Every frame is served at the ratio it is displayed at, so none of them is
   ever cropped — the widths below are just what the layout asks for. */
const SIZES = ['(min-width: 900px) 22vw', '(min-width: 640px) 30vw', '46vw'].join(', ');
---

<section id="story" class="section bg-night text-white">
  <div class="container-page">
    <span class="eyebrow eyebrow-on-dark" data-reveal>Our story</span>

    <div class="mt-2.5 max-w-[60rem]">
      <h2 class="h-section max-w-[24ch]" data-reveal style="--reveal-i:1">
        Built from firsthand experience.
      </h2>

      <div class="mt-4" data-reveal style="--reveal-i:2">
        <p class="intro-copy text-white/85">
          HOOD Community Servicing started with two people. Tim and Tamika spent a
          summer working as pool monitors for a local community, where they saw
          firsthand how much dependable staffing, clear communication, and good
          service matter.
        </p>

        <p class="story__body mt-3">
          They started the company to provide exactly that. What began at one pool
          has grown into a team supporting communities across DFW with pool services,
          maintenance, cleanups, and everyday community needs. The approach is still
          the same: show up, communicate, and take ownership of the work.
        </p>
      </div>
    </div>

    <div class="story__strip">
      <ul class="story__gallery">
        {
          strip.map((item, index) => (
            <li
              class:list={['story__figure', { 'story__figure--clone': item.clone }]}
              aria-hidden={item.clone ? 'true' : undefined}
              data-reveal={item.clone ? undefined : true}
              style={`--reveal-i:${index % gallery.length}`}
            >
              <img
                src={item.src}
                srcset={item.srcset}
                sizes={SIZES}
                alt={item.clone ? '' : item.alt}
                width="1000"
                height="1330"
                loading="lazy"
                decoding="async"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* .body-copy is keyed to --color-muted, which is a light-ground colour. Same
     measure and rhythm, re-grounded for the dark panel. */
  .story__body {
    max-width: 66ch;
    color: rgb(255 255 255 / 0.7);
    font-size: clamp(1rem, 0.96rem + 0.16vw, 1.125rem);
    font-weight: 400;
    line-height: 1.5;
  }

  /* --- Phone: a strip that keeps moving ---------------------------------
     Full bleed, because a marquee that stops inside the gutter reads as a
     row that didn't fit rather than as a run with no end. The negative
     margin takes it out to the container's border box, which below 640px is
     the viewport. */
  .story__strip {
    margin-top: clamp(3rem, 6vw, 5rem);
    margin-inline: calc(var(--gutter) * -1);
    overflow: hidden;
  }

  .story__gallery {
    /* --story-gap is the one measure the strip is built on: the space between
       frames at every tier, and on desktop the stagger is a multiple of it. */
    --story-gap: 0.75rem;
    --story-frame: clamp(9.5rem, 46vw, 14rem);
    /* One full set passes per cycle. Slow enough to read each picture, quick
       enough that the strip is obviously alive on a first look. */
    --story-run: 18s;

    display: flex;
    width: max-content;
    padding: 0;
    list-style: none;
    animation: story-marquee var(--story-run) linear infinite;
  }

  .story__figure {
    position: relative;
    flex: 0 0 var(--story-frame);
    overflow: hidden;
    /* The gap belongs to the frame, not the track. With `gap` the two halves
       of the track differ by exactly one gap and the loop jumps at the seam. */
    margin-inline-end: var(--story-gap);
    aspect-ratio: 3 / 4;
    border: 1px solid rgb(255 255 255 / 0.14);
    background-color: rgb(255 255 255 / 0.04);
  }

  /* The frame owns the ratio, so the picture fills it and is cropped rather
     than letterboxed, and the intrinsic width/height on the <img> is only
     there to describe the file. */
  .story__figure img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The grade the services previews already carry. */
    filter: saturate(0.88) contrast(1.03);
  }

  @keyframes story-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Frames the marquee has yet to bring in are off-screen when the section is
     read, so the entrance observer would fade them up mid-travel. The strip
     arrives whole instead; the cascade is a desktop effect. Specificity here
     has to clear `html[data-reveal-ready] [data-reveal]`, hence the three
     classes' worth of it. */
  @media (max-width: 639.98px) {
    .story__gallery .story__figure[data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* The reduced-motion block in global.css freezes any animation to 0.01ms,
     which would leave the strip parked on its first two frames with the rest
     clipped and unreachable. Hand it back as something to swipe. */
  @media (max-width: 639.98px) and (prefers-reduced-motion: reduce) {
    .story__strip {
      padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
    }

    .story__gallery {
      animation: none;
    }

    .story__figure {
      scroll-snap-align: start;
    }

    .story__figure--clone {
      display: none;
    }
  }

  /* The middle tier. Two columns on a tablet would hand the same proportions
     a phone gets to twice the width, and four snapshots at 400px tall each is
     most of a screen per picture. Three columns hold them to a readable size
     and the strip resolves in two ranks, the second one short. */
  @media (min-width: 640px) {
    .story__strip {
      margin-inline: 0;
      overflow: visible;
    }

    .story__gallery {
      --story-gap: 1rem;

      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
      gap: var(--story-gap);
      width: auto;
      animation: none;
    }

    .story__figure {
      margin-inline-end: 0;
    }

    .story__figure--clone {
      display: none;
    }

    /* Four frames across three columns leave the last one on its own. Under
       the middle of the rank above it reads as a closing frame; in the corner
       it reads as a leftover. Counted rather than :last-child, which the
       marquee clones now hold. */
    .story__figure:nth-child(4) {
      grid-column: 2;
    }
  }

  /* One row of four, every frame at its native ratio, alternate frames dropped
     by exactly two gaps — the stagger is measured in the same unit as the grid
     it sits in, so it reads as rhythm rather than as an arbitrary offset. The
     row is as tall as a dropped frame, so nothing overhangs the section's
     padding. */
  @media (min-width: 900px) {
    .story__strip {
      /* Four wider frames need less runway than five narrow ones did, so the
         strip sits nearer the paragraphs it is evidence for. */
      margin-top: clamp(2.5rem, 3.4vw, 3.25rem);
    }

    .story__gallery {
      --story-gap: 1.25rem;

      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .story__figure:nth-child(4) {
      grid-column: auto;
    }

    .story__figure:nth-child(even) {
      margin-top: calc(var(--story-gap) * 2);
    }
  }
</style>
