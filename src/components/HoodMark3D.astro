---
import { withBase } from '../utils/paths';

interface Props {
  modelUrl?: string;
  label?: string;
}

const {
  modelUrl = withBase('/models/hood-mark.glb'),
  label = 'Three-dimensional HOOD mark',
} = Astro.props;

const fallbackMask = `url("${withBase('/hood-mark.svg')}")`;
---

<div
  class="mark"
  data-hood-mark-3d
  data-model-url={modelUrl}
  role="img"
  aria-label={label}
  style={`--mark-fallback-mask: ${fallbackMask}`}
>
  <canvas class="mark__canvas" data-mark-canvas aria-hidden="true"></canvas>
  <span class="mark__fallback" aria-hidden="true"></span>
</div>

<style>
  .mark {
    position: relative;
    width: 100%;
    height: clamp(250px, 64vw, 310px);
    overflow: hidden;
    outline: none;
    background: transparent;
  }

  .mark__canvas,
  .mark__fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .mark__canvas {
    display: block;
    background: transparent;
    opacity: 0;
    transition: opacity 320ms ease;
  }

  .mark[data-loaded] {
    cursor: grab;
    touch-action: none;
  }

  .mark[data-dragging] {
    cursor: grabbing;
    user-select: none;
    -webkit-user-select: none;
  }

  .mark__fallback {
    margin: auto;
    width: min(52%, 210px);
    height: auto;
    aspect-ratio: 1;
    background-color: var(--color-brand-red);
    -webkit-mask: var(--mark-fallback-mask) center / contain no-repeat;
    mask: var(--mark-fallback-mask) center / contain no-repeat;
    transition: opacity 220ms ease;
  }

  .mark[data-loaded] .mark__canvas {
    opacity: 1;
  }

  .mark[data-loaded] .mark__fallback {
    opacity: 0;
  }

  @media (min-width: 768px) {
    .mark {
      height: clamp(330px, 35vw, 430px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark__canvas {
      display: none;
    }

    .mark__fallback {
      transition: none;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  document.querySelectorAll<HTMLElement>('[data-hood-mark-3d]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-mark-canvas]');
    const modelUrl = root.dataset.modelUrl;

    if (!canvas) {
      console.error('[HOOD 3D mark] Canvas is missing; the static fallback will remain visible.');
      return;
    }

    if (!modelUrl) {
      root.dataset.modelState = 'error';
      console.error(
        '[HOOD 3D mark] data-model-url is missing; the static fallback will remain visible.',
      );
      return;
    }

    let resolvedModelUrl: URL;
    try {
      resolvedModelUrl = new URL(modelUrl, window.location.href);
    } catch (error) {
      root.dataset.modelState = 'error';
      console.error(
        `[HOOD 3D mark] Invalid model URL "${modelUrl}"; the static fallback will remain visible.`,
        error,
      );
      return;
    }

    let initialized = false;

    const initialize = async () => {
      if (initialized || reducedMotion.matches) return;
      initialized = true;
      root.dataset.modelState = 'loading';

      try {
        const [THREE, { GLTFLoader }] = await Promise.all([
          import('three'),
          import('three/addons/loaders/GLTFLoader.js'),
        ]);

        const renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: true,
          antialias: true,
          powerPreference: 'high-performance',
        });
        renderer.setClearColor(0x000000, 0);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.NoToneMapping;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(29, 1, 0.1, 100);
        const cameraDirection = new THREE.Vector3(0.34, 0.18, 5.35).normalize();
        const mobileViewport = window.matchMedia('(max-width: 767px)');

        // Neutral lights reveal the red material's front and side planes. No
        // coloured rim or simulated shadow is used.
        scene.add(new THREE.HemisphereLight(0xffffff, 0x343434, 1));

        const key = new THREE.DirectionalLight(0xffffff, 1.5);
        key.position.set(4.2, 4.8, 5.5);
        scene.add(key);

        const side = new THREE.DirectionalLight(0xffffff, 0.85);
        side.position.set(-4.5, -1.4, 2.8);
        scene.add(side);

        const back = new THREE.DirectionalLight(0xffffff, 0.32);
        back.position.set(-2, 3, -4);
        scene.add(back);

        const holder = new THREE.Group();
        holder.rotation.set(-0.2, -0.52, -0.045);
        holder.position.set(0.15, -0.14, 0);
        holder.scale.setScalar(mobileViewport.matches ? 0.84 : 0.9);
        scene.add(holder);

        const loader = new GLTFLoader();
        const gltf = await new Promise<Awaited<ReturnType<typeof loader.loadAsync>>>(
          (resolve, reject) => {
            loader.load(resolvedModelUrl.href, resolve, undefined, (error) => {
              console.error(
                `[HOOD 3D mark] GLTFLoader failed to load ${resolvedModelUrl.href}`,
                error,
              );
              reject(error);
            });
          },
        );
        const model = gltf.scene;
        const importedMaterials = new Set<InstanceType<typeof THREE.Material>>();
        const hoodMaterial = new THREE.MeshStandardMaterial({
          color: 0xdf231c,
          metalness: 0.03,
          roughness: 0.72,
        });

        model.traverse((child) => {
          if (!(child instanceof THREE.Mesh)) return;

          const materials = Array.isArray(child.material) ? child.material : [child.material];
          materials.forEach((material) => importedMaterials.add(material));
          child.material = hoodMaterial;
        });
        importedMaterials.forEach((material) => material.dispose());

        const bounds = new THREE.Box3().setFromObject(model);
        const center = bounds.getCenter(new THREE.Vector3());
        const size = bounds.getSize(new THREE.Vector3());
        const modelScale = 2.7 / Math.max(size.x, size.y, size.z);
        model.scale.setScalar(modelScale);
        model.position.copy(center).multiplyScalar(-modelScale);
        holder.add(model);

        const halfSize = size.clone().multiplyScalar(modelScale * 0.5);
        const modelCorners = [-1, 1].flatMap((x) =>
          [-1, 1].flatMap((y) =>
            [-1, 1].map(
              (z) => new THREE.Vector3(halfSize.x * x, halfSize.y * y, halfSize.z * z),
            ),
          ),
        );

        const getScaleRange = () =>
          mobileViewport.matches
            ? { entry: 0.84, rest: 1.02 }
            : { entry: 0.9, rest: 1.1 };

        const pointerMotion = {
          positionX: 0.22,
          positionY: 0.16,
          rotationX: 0.18,
          rotationY: 0.32,
          rotationZ: 0.04,
        };

        const getFramingPoints = () => {
          const points: InstanceType<typeof THREE.Vector3>[] = [];
          const matrix = new THREE.Matrix4();
          const quaternion = new THREE.Quaternion();
          const position = new THREE.Vector3();
          const scale = new THREE.Vector3();
          const rotation = new THREE.Euler();
          const scaleRange = getScaleRange();
          const pointerSamples = finePointer.matches ? [-1, 1] : [0];
          const spinYawSamples = Array.from({ length: 8 }, (_, index) =>
            (index / 8) * Math.PI * 2,
          );
          const spinPitchSamples = Array.from({ length: 8 }, (_, index) =>
            (index / 8) * Math.PI * 2,
          );

          // Sample the authored motion path, cursor response, and the complete
          // interactive yaw range so a dragged mark stays inside the canvas.
          for (let step = 0; step <= 12; step += 1) {
            const progress = step / 12;
            const baseRotationX = THREE.MathUtils.lerp(-0.2, -0.09, progress);
            const baseRotationY = THREE.MathUtils.lerp(-0.52, -0.08, progress);
            const baseRotationZ = THREE.MathUtils.lerp(-0.045, 0.01, progress);
            const modelMotionScale = THREE.MathUtils.lerp(
              scaleRange.entry,
              scaleRange.rest,
              progress,
            );
            scale.setScalar(modelMotionScale);

            for (const pointerSampleX of pointerSamples) {
              for (const pointerSampleY of pointerSamples) {
                position.set(
                  THREE.MathUtils.lerp(0.15, -0.08, progress) +
                    pointerSampleX * pointerMotion.positionX,
                  THREE.MathUtils.lerp(-0.14, 0.1, progress) -
                    pointerSampleY * pointerMotion.positionY,
                  0,
                );

                for (const spinYaw of spinYawSamples) {
                  for (const spinPitch of spinPitchSamples) {
                    rotation.set(
                      baseRotationX + pointerSampleY * pointerMotion.rotationX + spinPitch,
                      baseRotationY + pointerSampleX * pointerMotion.rotationY + spinYaw,
                      baseRotationZ + pointerSampleX * pointerMotion.rotationZ,
                    );
                    quaternion.setFromEuler(rotation);
                    matrix.compose(position, quaternion, scale);
                    modelCorners.forEach((corner) =>
                      points.push(corner.clone().applyMatrix4(matrix)),
                    );
                  }
                }
              }
            }
          }

          return points;
        };

        const frameCamera = () => {
          const points = getFramingPoints();
          const framingCenter = new THREE.Box3().setFromPoints(points).getCenter(new THREE.Vector3());
          // Fill 25% more of the canvas than the original framing while still
          // fitting the complete interactive rotation envelope.
          const targetNdcExtent = 0.975;

          const projectedExtentAt = (distance: number) => {
            camera.position.copy(framingCenter).addScaledVector(cameraDirection, distance);
            camera.lookAt(framingCenter);
            camera.updateMatrixWorld(true);
            camera.updateProjectionMatrix();

            let extent = 0;
            for (const point of points) {
              const cameraPoint = point.clone().applyMatrix4(camera.matrixWorldInverse);
              if (cameraPoint.z >= -camera.near) return Number.POSITIVE_INFINITY;
              const projected = point.clone().project(camera);
              extent = Math.max(extent, Math.abs(projected.x), Math.abs(projected.y));
            }
            return extent;
          };

          let nearDistance = 0.5;
          let farDistance = 4;
          while (projectedExtentAt(farDistance) > targetNdcExtent && farDistance < 50) {
            farDistance *= 1.5;
          }

          // Solve the perspective fit against the actual responsive aspect.
          for (let iteration = 0; iteration < 24; iteration += 1) {
            const distance = (nearDistance + farDistance) / 2;
            if (projectedExtentAt(distance) > targetNdcExtent) nearDistance = distance;
            else farDistance = distance;
          }

          camera.position.copy(framingCenter).addScaledVector(cameraDirection, farDistance);
          camera.lookAt(framingCenter);
          camera.updateMatrixWorld(true);
          camera.updateProjectionMatrix();
        };

        let frame = 0;
        let active = false;
        let pointerX = 0;
        let pointerY = 0;
        let targetX = 0.15;
        let targetY = -0.14;
        let targetScale = getScaleRange().entry;
        let targetRotationX = -0.2;
        let targetRotationY = -0.52;
        let targetRotationZ = -0.045;
        const spinQuaternion = new THREE.Quaternion();
        const restingSpinQuaternion = new THREE.Quaternion();
        const baseQuaternion = new THREE.Quaternion();
        const targetQuaternion = new THREE.Quaternion();
        const deltaQuaternion = new THREE.Quaternion();
        const interactiveRotation = new THREE.Euler(0, 0, 0, 'YXZ');
        const baseRotation = new THREE.Euler();
        let spinVelocityX = 0;
        let spinVelocityY = 0;
        let dragging = false;
        let dragPointerId = -1;
        let lastDragX = 0;
        let lastDragY = 0;
        let lastDragTime = 0;
        let returnTimer = 0;
        let returningToRest = false;

        const applySpinDelta = (pitch: number, yaw: number) => {
          interactiveRotation.set(pitch, yaw, 0);
          deltaQuaternion.setFromEuler(interactiveRotation);
          spinQuaternion.premultiply(deltaQuaternion).normalize();
        };

        const cancelReturnToRest = () => {
          if (returnTimer) window.clearTimeout(returnTimer);
          returnTimer = 0;
          returningToRest = false;
        };

        const resize = () => {
          const { width, height } = root.getBoundingClientRect();
          if (!width || !height) return;
          renderer.setSize(width, height, false);
          camera.aspect = width / height;
          frameCamera();
        };

        const measureScroll = () => {
          const rect = root.getBoundingClientRect();
          const rawProgress = THREE.MathUtils.clamp(
            (window.innerHeight - rect.top) / (window.innerHeight + rect.height),
            0,
            1,
          );
          const progress = THREE.MathUtils.smoothstep(rawProgress, 0.08, 0.68);

          // About 25 degrees from entry to rest, paired with a concise scale
          // and position change. User-controlled rotation is layered on top.
          targetRotationY = THREE.MathUtils.lerp(-0.52, -0.08, progress);
          targetRotationX = THREE.MathUtils.lerp(-0.2, -0.09, progress);
          targetRotationZ = THREE.MathUtils.lerp(-0.045, 0.01, progress);
          const scaleRange = getScaleRange();
          targetScale = THREE.MathUtils.lerp(scaleRange.entry, scaleRange.rest, progress);
          targetX = THREE.MathUtils.lerp(0.15, -0.08, progress);
          targetY = THREE.MathUtils.lerp(-0.14, 0.1, progress);
          key.position.x = THREE.MathUtils.lerp(4.2, 3.1, progress);
        };

        const render = () => {
          frame = 0;
          if (!active) return;

          if (!dragging) {
            if (returningToRest) {
              spinVelocityX = 0;
              spinVelocityY = 0;
              spinQuaternion.slerp(restingSpinQuaternion, 0.075);

              if (spinQuaternion.angleTo(restingSpinQuaternion) < 0.001) {
                spinQuaternion.identity();
                returningToRest = false;
              }
            } else {
              applySpinDelta(spinVelocityX, spinVelocityY);
              spinVelocityX *= 0.972;
              spinVelocityY *= 0.972;
              if (Math.abs(spinVelocityX) < 0.0001) spinVelocityX = 0;
              if (Math.abs(spinVelocityY) < 0.0001) spinVelocityY = 0;
            }
          }

          baseRotation.set(
            targetRotationX + pointerY * pointerMotion.rotationX,
            targetRotationY + pointerX * pointerMotion.rotationY,
            targetRotationZ + pointerX * pointerMotion.rotationZ,
          );
          baseQuaternion.setFromEuler(baseRotation);
          targetQuaternion.copy(spinQuaternion).multiply(baseQuaternion);
          const nextX = targetX + pointerX * pointerMotion.positionX;
          const nextY = targetY - pointerY * pointerMotion.positionY;
          const movement = Math.max(
            holder.quaternion.angleTo(targetQuaternion),
            Math.abs(holder.position.x - nextX),
            Math.abs(holder.position.y - nextY),
            Math.abs(holder.scale.x - targetScale),
            Math.abs(spinVelocityX),
            Math.abs(spinVelocityY),
            returningToRest ? spinQuaternion.angleTo(restingSpinQuaternion) : 0,
          );

          if (dragging) holder.quaternion.copy(targetQuaternion);
          else holder.quaternion.slerp(targetQuaternion, 0.15);
          holder.position.x = THREE.MathUtils.lerp(holder.position.x, nextX, 0.115);
          holder.position.y = THREE.MathUtils.lerp(holder.position.y, nextY, 0.115);
          holder.scale.setScalar(THREE.MathUtils.lerp(holder.scale.x, targetScale, 0.115));

          renderer.render(scene, camera);
          if (movement > 0.0007 || dragging) frame = requestAnimationFrame(render);
        };

        const requestRender = () => {
          if (active && !frame) frame = requestAnimationFrame(render);
        };

        const scheduleReturnToRest = (delay = 850) => {
          cancelReturnToRest();
          returnTimer = window.setTimeout(() => {
            returnTimer = 0;
            returningToRest = true;
            spinVelocityX = 0;
            spinVelocityY = 0;
            requestRender();
          }, delay);
        };

        const start = () => {
          if (active || reducedMotion.matches) return;
          active = true;
          resize();
          measureScroll();
          requestRender();
        };

        const stop = () => {
          active = false;
          if (frame) cancelAnimationFrame(frame);
          frame = 0;
        };

        resize();
        renderer.render(scene, camera);
        root.dataset.modelState = 'loaded';
        root.toggleAttribute('data-loaded', true);
        root.tabIndex = 0;
        root.setAttribute(
          'aria-label',
          `${root.getAttribute('aria-label') ?? 'Three-dimensional mark'}. Drag in any direction or use the arrow keys to spin.`,
        );

        reducedMotion.addEventListener('change', (event) => {
          root.toggleAttribute('data-loaded', !event.matches);
          if (event.matches) {
            cancelReturnToRest();
            spinQuaternion.identity();
            spinVelocityX = 0;
            spinVelocityY = 0;
            root.removeAttribute('tabindex');
            stop();
          } else {
            root.tabIndex = 0;
            const rect = root.getBoundingClientRect();
            if (rect.bottom > 0 && rect.top < window.innerHeight) start();
          }
        });

        const visibilityObserver = new IntersectionObserver(
          ([entry]) => (entry.isIntersecting ? start() : stop()),
          { rootMargin: '10% 0px', threshold: 0 },
        );
        visibilityObserver.observe(root);

        const resizeObserver = new ResizeObserver(() => {
          resize();
          measureScroll();
          requestRender();
        });
        resizeObserver.observe(root);

        mobileViewport.addEventListener('change', () => {
          resize();
          measureScroll();
          requestRender();
        });

        window.addEventListener(
          'scroll',
          () => {
            if (!active) return;
            if (!dragging) {
              cancelReturnToRest();
              spinQuaternion.identity();
              spinVelocityX = 0;
              spinVelocityY = 0;
            }
            measureScroll();
            requestRender();
          },
          { passive: true },
        );

        const updatePointerFollow = (event: PointerEvent) => {
          if (!finePointer.matches || event.pointerType !== 'mouse') return;
          const rect = root.getBoundingClientRect();
          pointerX = THREE.MathUtils.clamp(
            (event.clientX - (rect.left + rect.width / 2)) / Math.max(rect.width * 0.5, 1),
            -1,
            1,
          );
          pointerY = THREE.MathUtils.clamp(
            (event.clientY - (rect.top + rect.height / 2)) / Math.max(rect.height * 0.55, 1),
            -1,
            1,
          );
          requestRender();
        };

        window.addEventListener('pointermove', updatePointerFollow, { passive: true });
        window.addEventListener('pointerout', (event) => {
          if (event.relatedTarget === null && !dragging) {
            pointerX = 0;
            pointerY = 0;
            requestRender();
          }
        });

        root.addEventListener('pointerdown', (event) => {
          if (!active || (event.pointerType === 'mouse' && event.button !== 0)) return;
          cancelReturnToRest();
          dragging = true;
          dragPointerId = event.pointerId;
          lastDragX = event.clientX;
          lastDragY = event.clientY;
          lastDragTime = event.timeStamp;
          spinVelocityX = 0;
          spinVelocityY = 0;
          root.toggleAttribute('data-dragging', true);
          root.setPointerCapture(event.pointerId);
          event.preventDefault();
          requestRender();
        });

        root.addEventListener('pointermove', (event) => {
          if (!dragging || event.pointerId !== dragPointerId) return;
          const deltaX = event.clientX - lastDragX;
          const deltaY = event.clientY - lastDragY;
          const elapsed = Math.max(event.timeStamp - lastDragTime, 8);
          const frameRateScale = 16.67 / elapsed;
          const rect = root.getBoundingClientRect();
          const yawDelta = (deltaX / Math.max(rect.width, 1)) * Math.PI * 2;
          const pitchDelta = (deltaY / Math.max(rect.height, 1)) * Math.PI * 2;

          applySpinDelta(pitchDelta, yawDelta);
          spinVelocityX = THREE.MathUtils.clamp(
            pitchDelta * frameRateScale,
            -0.45,
            0.45,
          );
          spinVelocityY = THREE.MathUtils.clamp(yawDelta * frameRateScale, -0.45, 0.45);
          lastDragX = event.clientX;
          lastDragY = event.clientY;
          lastDragTime = event.timeStamp;
          event.preventDefault();
          requestRender();
        });

        const endDrag = (event: PointerEvent, cancelled = false) => {
          if (!dragging || event.pointerId !== dragPointerId) return;
          dragging = false;
          dragPointerId = -1;
          root.removeAttribute('data-dragging');
          if (cancelled || event.timeStamp - lastDragTime > 80) {
            spinVelocityX = 0;
            spinVelocityY = 0;
          }
          if (root.hasPointerCapture(event.pointerId)) {
            root.releasePointerCapture(event.pointerId);
          }
          updatePointerFollow(event);
          scheduleReturnToRest(cancelled ? 0 : 850);
          requestRender();
        };

        root.addEventListener('pointerup', (event) => endDrag(event));
        root.addEventListener('pointercancel', (event) => endDrag(event, true));
        root.addEventListener('lostpointercapture', (event) => endDrag(event));

        root.addEventListener('keydown', (event) => {
          if (
            event.key !== 'ArrowLeft' &&
            event.key !== 'ArrowRight' &&
            event.key !== 'ArrowUp' &&
            event.key !== 'ArrowDown' &&
            event.key !== 'Home'
          ) {
            return;
          }

          const step = event.shiftKey ? 0.35 : 0.18;
          cancelReturnToRest();
          if (event.key === 'ArrowLeft') applySpinDelta(0, -step);
          else if (event.key === 'ArrowRight') applySpinDelta(0, step);
          else if (event.key === 'ArrowUp') applySpinDelta(-step, 0);
          else if (event.key === 'ArrowDown') applySpinDelta(step, 0);
          else spinQuaternion.identity();

          event.preventDefault();
          spinVelocityX = 0;
          spinVelocityY = 0;
          if (event.key !== 'Home') scheduleReturnToRest();
          requestRender();
        });
      } catch (error) {
        initialized = false;
        root.dataset.modelState = 'error';
        console.error(
          `[HOOD 3D mark] Initialization failed for ${resolvedModelUrl.href}; the static fallback will remain visible.`,
          error,
        );
      }
    };

    const loadObserver = new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting || reducedMotion.matches) return;
        observer.disconnect();
        void initialize();
      },
      { rootMargin: '320px 0px', threshold: 0 },
    );
    loadObserver.observe(root);

    reducedMotion.addEventListener('change', () => {
      if (!reducedMotion.matches) void initialize();
    });
  });
</script>
