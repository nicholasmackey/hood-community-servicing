---
/*
 * UI ONLY — there is no backend yet.
 * The form intentionally has no `action`. Before launch, point it at a handler
 * (Astro Actions, a form endpoint, or an email service) and add server-side
 * validation plus a spam guard.
 *
 * The CTA is the form heading rather than a separate promotional panel. This
 * keeps the close direct: invitation, then fields.
 */

const fields = [
  { id: 'name', label: 'Name', type: 'text', autocomplete: 'name', required: true },
  {
    id: 'company',
    label: 'Company / Organization',
    type: 'text',
    autocomplete: 'organization',
    required: false,
  },
  { id: 'email', label: 'Email', type: 'email', autocomplete: 'email', required: true },
  { id: 'phone', label: 'Phone', type: 'tel', autocomplete: 'tel', required: false },
  {
    id: 'property',
    label: 'Community / Property Name',
    type: 'text',
    autocomplete: 'off',
    required: false,
  },
] as const;

const needs = [
  'Lifeguard staffing + pool monitoring',
  'Pool management',
  'Pet waste removal + haul',
  'Small hauls',
  'Common area cleanups',
  'Power washing',
  'Community support',
  'Something else',
];

const labelClass = 'block text-[13px] font-semibold uppercase tracking-[0.1em] text-white/70';

const inputClass =
  'mt-2 w-full rounded-sm border border-white/40 bg-white/[0.04] px-4 py-3.5 text-[16px] text-white placeholder:text-white/35 transition-colors hover:border-white/55 focus:border-white focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
---

<section id="contact" class="contact-form-section text-white" aria-labelledby="contact-form-title">
  <div class="container-page py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-[50rem]">
      <div class="border-b border-white/15 pb-8 text-center sm:pb-10">
        <h2
          id="contact-form-title"
          class="text-balance text-[clamp(2rem,1.15rem+4.2vw,4.75rem)] font-extrabold leading-[0.96] tracking-[-0.02em]"
          data-reveal
        >
          Ready to team up?
        </h2>
      </div>

      <form
        id="contact-form"
        class="mt-8 grid scroll-mt-24 gap-5 text-left sm:grid-cols-2 sm:gap-6"
      >
        {
          fields.map((field) => (
            <div class={field.id === 'property' ? 'sm:col-span-2' : ''}>
              <label class={labelClass} for={field.id}>
                {field.label}
                {!field.required && (
                  <span class="ml-1.5 font-normal normal-case tracking-normal text-white/40">
                    (optional)
                  </span>
                )}
              </label>
              <input
                id={field.id}
                name={field.id}
                type={field.type}
                autocomplete={field.autocomplete}
                required={field.required}
                class={inputClass}
              />
            </div>
          ))
        }

        <div class="sm:col-span-2">
          <label class={labelClass} for="need">What do you need help with?</label>
          <div class="relative">
            {/* color-scheme keeps the native option list dark instead of white-on-white */}
            <select
              id="need"
              name="need"
              required
              class={`${inputClass} appearance-none pr-12`}
              style="color-scheme: dark;"
            >
              <option value="">Select an option</option>
              {needs.map((need) => <option value={need}>{need}</option>)}
            </select>
            <svg
              aria-hidden="true"
              viewBox="0 0 16 16"
              class="pointer-events-none absolute top-1/2 right-4 h-4 w-4 -translate-y-1/2 text-white"
            >
              <path
                d="m3 6 5 5 5-5"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.75"
              ></path>
            </svg>
          </div>
        </div>

        <div class="sm:col-span-2">
          <label class={labelClass} for="message">
            Message
            <span class="ml-1.5 font-normal normal-case tracking-normal text-white/40">
              (optional)
            </span>
          </label>
          <textarea id="message" name="message" rows="4" class={inputClass}></textarea>
        </div>

        <div class="sm:col-span-2">
          <button
            type="submit"
            class="btn btn-primary w-full text-[17px] sm:w-auto sm:px-10 sm:py-4"
          >
            Send request
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-form-section {
    background-color: #2b2724;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }
</style>
