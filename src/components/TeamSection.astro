---
/*
 * Text-only by design. Hood have no headshots and are not commissioning any,
 * so this is a set of profiles rather than two cards with a hole in each: a
 * red rule, the name, the title, and what the person actually does. The
 * photography that shows the team is real is the strip in the story section
 * above, which is where it belongs.
 *
 * Names, titles, and the substance of the bios are Hood's own.
 */
const leaders = [
  {
    name: 'Tim Hood',
    role: 'Founder & CEO',
    bio: 'Tim started HOOD after working the job himself. He still runs the field side of it, from staffing and scheduling to the call that comes in when something on site needs attention.',
  },
  {
    name: 'Tamika Stokes',
    role: 'Director of Operations',
    bio: 'Tamika runs operations day to day: crews assigned, communities kept in the loop, and the small problems answered before they turn into complaints.',
  },
];
---

<section id="team" class="section bg-surface">
  <div class="container-page">
    <span class="eyebrow" data-reveal>The people behind HOOD</span>

    <div class="mt-2.5 max-w-[60rem]">
      <h2 class="h-section max-w-[24ch]" data-reveal style="--reveal-i:1">
        People you can actually get ahold of.
      </h2>

      <p class="intro-copy mt-4" data-reveal style="--reveal-i:2">
        When you reach out to HOOD, you’re talking to the people responsible for
        getting the work done. Clear communication, practical help, and a team
        that understands community operations.
      </p>
    </div>

    <ul class="leaders">
      {
        leaders.map((leader, index) => (
          <li class="leader" data-reveal style={`--reveal-i:${index}`}>
            <h3 class="leader__name">{leader.name}</h3>
            <p class="eyebrow mt-2">{leader.role}</p>
            <p class="leader__bio">{leader.bio}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* The why-hood proofs on this same ground open on a hairline in ink; these
     open on the brand rule, which is the weight the services rows and the menu
     use. Same system, different register — and enough to keep two rule-topped
     lists on one page from reading as the same block twice. */
  .leaders {
    display: grid;
    gap: 2.75rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: 0;
    list-style: none;
  }

  .leader {
    padding-top: 1.25rem;
    border-top: 2px solid var(--color-brand-red);
  }

  .leader__name {
    font-size: clamp(1.75rem, 1.45rem + 0.95vw, 2.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .leader__bio {
    max-width: 46ch;
    margin-top: 1rem;
    color: var(--color-muted);
    font-size: clamp(1rem, 0.96rem + 0.16vw, 1.125rem);
    font-weight: 400;
    line-height: 1.55;
  }

  @media (min-width: 768px) {
    .leaders {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2rem, 4vw, 4rem);
    }
  }
</style>
