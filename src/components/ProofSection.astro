---
import ImagePlaceholder from './ImagePlaceholder.astro';

/*
 * ============================================================================
 * STRUCTURE ONLY — NO REAL PROOF CONTENT YET.
 *
 * Every item below is an empty slot. Nothing here is a real testimonial,
 * community, certification, number of seasons, or client. Real content must be
 * supplied by HOOD before this section ships. Do not fill these in with
 * plausible-sounding placeholders — an invented certification or client logo on
 * a staffing site is a liability, not a design detail.
 *
 * To fill in:
 *   testimonials — replace with real, attributed quotes (name + role + community)
 *   facts        — replace with verifiable figures, or delete the block entirely
 *   logos        — replace with permitted client/property marks only
 * ============================================================================
 */

// TODO: replace with real, attributed testimonials.
const testimonials = [
  { slot: 'Testimonial 1' },
  { slot: 'Testimonial 2' },
];

// TODO: replace with verifiable facts, or remove this block.
const facts = [
  { label: 'Communities served', slot: 'Awaiting content' },
  { label: 'Certifications', slot: 'Awaiting content' },
  { label: 'Experience', slot: 'Awaiting content' },
];

// TODO: replace with approved client / property logos.
const logoSlots = ['Client logo', 'Client logo', 'Client logo', 'Client logo'];
---

<section class="section border-b border-border">
  <div class="container-page">
    <h2
      class="max-w-[18ch] text-[32px] font-bold leading-[1.05] tracking-[-0.03em] md:text-[40px] lg:text-[48px]"
    >
      Built around the communities we serve.
    </h2>

    <!-- Testimonials -->
    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:mt-20">
      {
        testimonials.map((testimonial) => (
          <figure class="flex min-h-[220px] flex-col justify-between border border-dashed border-border bg-surface p-8">
            <blockquote class="text-[20px] leading-[1.5] text-muted/70">
              {testimonial.slot} — quote goes here.
            </blockquote>
            <figcaption class="mt-8 text-[13px] font-semibold uppercase tracking-[0.14em] text-muted/70">
              Name, role, community
            </figcaption>
          </figure>
        ))
      }
    </div>

    <!-- Communities served / certifications / experience -->
    <dl class="mt-6 grid gap-6 sm:grid-cols-3">
      {
        facts.map((fact) => (
          <div class="border border-dashed border-border bg-surface p-8">
            <dt class="text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">
              {fact.label}
            </dt>
            <dd class="mt-3 text-[18px] leading-[1.5] text-muted/70">{fact.slot}</dd>
          </div>
        ))
      }
    </dl>

    <!-- Client / property logos -->
    <div class="mt-6 border border-dashed border-border bg-surface p-8">
      <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-muted">
        Client / property logos
      </p>
      <ul class="mt-6 grid grid-cols-2 gap-6 sm:grid-cols-4">
        {
          logoSlots.map((slot) => (
            <li class="flex h-16 items-center justify-center border border-border bg-background text-[12px] font-medium text-muted/70">
              {slot}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Supporting photography -->
    <ImagePlaceholder
      label="Pool aerial"
      src="/images/pool-aerial.webp"
      class="mt-6 aspect-[16/9] lg:aspect-[21/9]"
    />
  </div>
</section>
